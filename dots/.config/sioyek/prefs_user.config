# =============================================================================
# FONT SETTINGS
# =============================================================================

# The font used for the command palette, bookmarks, and file browser
ui_font             JetBrains Mono Regular

# The base size of the UI font (default is around 20)
font_size           22

# Specific size for the bottom status bar (optional, usually matches font_size)
status_bar_font_size 22

# =============================================================================
# TOKYONIGHT NIGHT THEME
# High contrast, dark mode optimized for late-night research
# =============================================================================

background_color        #1a1b26
text_highlight_color    #7aa2f7
visual_mark_color       #7aa2f77f

# Custom Color Mode (Dark Mode processing)
custom_background_color #1a1b26
custom_text_color       #c0caf5

# UI Styling (Status bar, menus)
ui_text_color           #a9b1d6
ui_background_color     #16161e
ui_selected_text_color  #c0caf5
ui_selected_background_color #2f3549

# Status Bar
status_bar_font_size    20
status_bar_color        #16161e
status_bar_text_color   #7aa2f7

# =============================================================================
# LINUX & ORG MODE OPTIMIZATION
# =============================================================================

# Inverse Search for Emacs/Org-mode
# Command optimized for Linux socket communication (emacsclient).
# %1 = File path, %2 = Line Number, %3 = Column
# We wrap %1 in quotes to handle Linux file paths with spaces.
inverse_search_command  emacsclient --no-wait +%2:%3 "%1"

# Middle-click interactions
# Middle-click a paper title/citation to search Google Scholar (key 'g')
middle_click_search_engine  g
shift_middle_click_search_engine l

# Search Highlight (Matches Tokyonight Orange for visibility)
search_highlight_color  #e0af68

# =============================================================================
# PERFORMANCE & QoL
# =============================================================================

# Launch behavior
# 1 = Start in Dark Mode immediately
startup_commands        toggle_custom_color

# Window Management
# 0 = Open new files in the current window (Better for Tiling WMs like i3/Sway)
should_launch_new_window 0

# Zoom & View
# Smart fit helps with 2-column scientific papers
default_zoom_level      fit_to_page_width_smart

# Touchpad/Scroll speed (Adjust for Linux libinput sensitivity)
smooth_scroll_speed     3
smooth_scroll_drag      3000

# Show exact filename in status bar (helpful when managing many versions of a paper)
show_document_name_in_statusbar 1
