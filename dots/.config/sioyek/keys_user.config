# =============================================================================
# NAVIGATION (Arrow Key Mappings)
# =============================================================================

# Standard Scroll (Smooth)
move_down           <down>
move_up             <up>
move_left           <left>
move_right          <right>

# Page / Screen jumps
# Control + Arrow for Page Up/Down
next_page           <C-down>
previous_page       <C-up>

# Shift + Arrow for Screen Up/Down (Faster scrolling)
screen_down         <S-down>
screen_up           <S-up>

# =============================================================================
# VIM-LIKE RESEARCH TOOLS (Retained)
# =============================================================================

# Jump to Start/End of file
goto_begining       gg
goto_end            G

# Search
search              /
next_item           n
previous_item       N

# Visual Mode (Select text to copy/highlight)
enter_visual_mode   v

# Bookmarks/Marks
add_mark            m
goto_mark           `

# =============================================================================
# SCIENTIFIC WRITING SHORTCUTS
# =============================================================================

# Inverse Search (SyncTex)
# Trigger this to jump back to your .tex/.org file in Emacs
toggle_synctex      <f4>
# Note: In Linux, Ctrl+Click on text also triggers this if Synctex is active.

# Smart Overview (The "Portal" Feature)
# Press Shift+K while hovering over a citation [1] to see the reference
# without scrolling to the bibliography.
overview_under_cursor <S-k>

# Zoom Controls
zoom_in             +
zoom_out            -
fit_to_page_width   w
fit_to_page_width_smart <S-w>

# Navigation History (Jump back after clicking a link)
prev_state          <backspace>
next_state          <S-backspace>

# Toggle Dark Mode
toggle_custom_color <f8>
