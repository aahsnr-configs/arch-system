#!/usr/bin/env bash

# Wayland Screenshot Script
# Uses grim, slurp, and swappy for capturing and editing screenshots
# Requires: grim, slurp, swappy

# Strict error handling
set -Eeuo pipefail

# Trap for cleanup and error reporting
trap 'error_handler ${LINENO} $?' ERR
trap cleanup EXIT INT TERM

# Global variables
readonly SCRIPT_NAME="$(basename "$0")"
TEMP_FILES=()

# Color codes for output
readonly RED='\033[0;31m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m' # No Color

# Error handler function
error_handler() {
    local line_number="$1"
    local exit_code="$2"
    echo -e "${RED}Error on line ${line_number}: Command exited with status ${exit_code}${NC}" >&2
    exit "${exit_code}"
}

# Cleanup function
cleanup() {
    local exit_code=$?
    
    # Clean up any temporary files
    if [[ ${#TEMP_FILES[@]} -gt 0 ]]; then
        for temp_file in "${TEMP_FILES[@]}"; do
            [[ -f "$temp_file" ]] && rm -f "$temp_file"
        done
    fi
    
    exit "${exit_code}"
}

# Function to display usage information
usage() {
    cat << EOF
Usage: ${SCRIPT_NAME} [OPTION]

Take screenshots on Wayland using grim, slurp, and swappy.

Options:
    -r, --region        Capture a selected region (default)
    -f, --fullscreen    Capture the entire screen
    -w, --window        Capture the focused window (requires swaymsg and jq)
    -h, --help          Display this help message

Examples:
    ${SCRIPT_NAME}              # Select a region interactively
    ${SCRIPT_NAME} --fullscreen  # Capture entire screen
    ${SCRIPT_NAME} --window      # Capture focused window

Notes:
    - Screenshots are saved according to your swappy configuration
    - Press Escape during region selection to cancel
    - Window capture requires a running Sway compositor

EOF
}

# Function to check if required commands exist
check_dependencies() {
    local deps=("$@")
    local missing=()
    
    for cmd in "${deps[@]}"; do
        if ! command -v "$cmd" &> /dev/null; then
            missing+=("$cmd")
        fi
    done
    
    if [[ ${#missing[@]} -gt 0 ]]; then
        echo -e "${RED}Error: Missing required dependencies: ${missing[*]}${NC}" >&2
        echo "Please install the missing packages and try again." >&2
        exit 1
    fi
}

# Function to verify Wayland session
check_wayland() {
    if [[ -z "${WAYLAND_DISPLAY:-}" ]] && [[ -z "${XDG_SESSION_TYPE:-}" || "${XDG_SESSION_TYPE}" != "wayland" ]]; then
        echo -e "${YELLOW}Warning: Not running in a Wayland session${NC}" >&2
        echo "This script is designed for Wayland. Results may be unpredictable." >&2
        read -p "Continue anyway? [y/N] " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            exit 0
        fi
    fi
}

# Function to capture a region
capture_region() {
    check_dependencies "grim" "slurp" "swappy"
    check_wayland
    
    local selection
    # Capture slurp output, exit gracefully if cancelled
    if ! selection=$(slurp 2>&1); then
        local slurp_exit=$?
        if [[ $slurp_exit -eq 1 ]]; then
            echo "Selection cancelled." >&2
            exit 0
        else
            echo -e "${RED}Error: slurp failed with exit code ${slurp_exit}${NC}" >&2
            echo "Output: ${selection}" >&2
            exit 1
        fi
    fi
    
    # Ensure selection is not empty
    if [[ -z "$selection" ]]; then
        echo "Error: No region selected" >&2
        exit 1
    fi
    
    # Capture and pipe to swappy
    if ! grim -g "$selection" - | swappy -f -; then
        echo -e "${RED}Error: Screenshot capture or editing failed${NC}" >&2
        exit 1
    fi
}

# Function to capture fullscreen
capture_fullscreen() {
    check_dependencies "grim" "swappy"
    check_wayland
    
    if ! grim - | swappy -f -; then
        echo -e "${RED}Error: Screenshot capture or editing failed${NC}" >&2
        exit 1
    fi
}

# Function to capture focused window
capture_window() {
    check_dependencies "grim" "swappy" "swaymsg" "jq"
    check_wayland
    
    local geometry
    local sway_tree
    
    # Get sway tree with error handling
    if ! sway_tree=$(swaymsg -t get_tree 2>&1); then
        echo -e "${RED}Error: Failed to communicate with Sway${NC}" >&2
        echo "Make sure you are running Sway compositor" >&2
        echo "Output: ${sway_tree}" >&2
        exit 1
    fi
    
    # Extract geometry using jq
    # Updated query to handle both pid and visible checks more safely
    if ! geometry=$(echo "$sway_tree" | jq -r '.. | select(.type?) | select(.focused==true) | .rect | "\(.x),\(.y) \(.width)x\(.height)"' 2>&1); then
        echo -e "${RED}Error: Failed to parse window geometry${NC}" >&2
        echo "Output: ${geometry}" >&2
        exit 1
    fi
    
    # Verify geometry is not empty and has correct format
    if [[ -z "$geometry" ]]; then
        echo -e "${RED}Error: Could not determine focused window geometry${NC}" >&2
        echo "Make sure a window is focused" >&2
        exit 1
    fi
    
    # Validate geometry format (x,y widthxheight)
    if ! [[ "$geometry" =~ ^[0-9]+,[0-9]+\ [0-9]+x[0-9]+$ ]]; then
        echo -e "${RED}Error: Invalid geometry format: ${geometry}${NC}" >&2
        exit 1
    fi
    
    # Capture and pipe to swappy
    if ! grim -g "$geometry" - | swappy -f -; then
        echo -e "${RED}Error: Screenshot capture or editing failed${NC}" >&2
        exit 1
    fi
}

# Main script logic
main() {
    # Default to region capture if no arguments provided
    if [[ $# -eq 0 ]]; then
        capture_region
        exit 0
    fi
    
    # Parse arguments
    case "$1" in
        -r|--region)
            capture_region
            ;;
        -f|--fullscreen)
            capture_fullscreen
            ;;
        -w|--window)
            capture_window
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo -e "${RED}Error: Unknown option '$1'${NC}" >&2
            echo "Use --help for usage information" >&2
            exit 1
            ;;
    esac
}

main "$@"
